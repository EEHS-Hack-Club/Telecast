# Copy to .env for `pnpm dev`, or set these on your host. See README for where each comes from.

# From your app at https://auth.hackclub.com/developer/apps.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# Emails (the ones used for Hack Club Auth), comma-separated. Admins can always sign in
# and are the ones who add the other organisers.
TELECAST_ADMINS=

# The address people will use. Only needed if a proxy in front doesn't pass it along.
# PUBLIC_URL=https://telecast.example.com
