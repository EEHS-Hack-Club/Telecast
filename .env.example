# Copy to .env for `pnpm dev`, or set these on your host. See README for where each comes from.

# From your Slack app's "Basic Information" page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# From "OAuth & Permissions" after installing the app to the workspace. Starts with xoxb-.
SLACK_BOT_TOKEN=

# Slack member IDs (profile → ⋮ → Copy member ID), comma-separated. Admins can always sign in
# and are the ones who choose the organisers' channel.
TELECAST_ADMINS=

# The address people will use. Only needed if a proxy in front doesn't pass it along.
# PUBLIC_URL=https://telecast.haven.london
